# Endpoint — any OpenAI-compatible /v1/chat/completions server.
# Local Ollama default below; swap to vLLM in production.
CRUCIBLE_API_BASE=http://localhost:11434/v1
CRUCIBLE_API_KEY=ollama

# Models — `tinyllama` for local dev (1.1B, runs on CPU). Override per env.
CRUCIBLE_DEFAULT_MODEL=tinyllama
CRUCIBLE_SYNTHESIZER_MODEL=tinyllama

# Transport tuning
CRUCIBLE_TIMEOUT_SECONDS=120
CRUCIBLE_MAX_RETRIES=2
